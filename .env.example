# ─────────────────────────────────────────────────────────────
# 筑梦之境 · Dreamloom Space — 环境变量示例
#
# 用法：复制为 `.env.local`（本地开发，不进 git），或写进部署平台的环境变量。
# 其余行为参数（字数档、预算、限流、阈值）都在 `config/app.yaml`，不要写在这里。
#
# 加载顺序（`server/config.js`）：
#   1. 真实环境变量（部署平台注入的，优先级最高）
#   2. `.env.local` → `.env`（Node 内置 loadEnvFile，不引 dotenv）
#   3. `secrets.json`（非 dotfile，只补空缺；给会剔除 `.env*` 的部署平台用）
# 同一变量出现多次时，前面的赢。
# ─────────────────────────────────────────────────────────────

# ── 文本模型（必填） ─────────────────────────────────────────
# OpenAI 兼容接口地址，写到 /v1 为止，不要带 /chat/completions
LLM_BASE_URL=https://api.deepseek.com/v1

# 你的 API Key。服务端不落盘、不写日志；浏览器里填的那把优先级更高
LLM_API_KEY=

# 模型名。DeepSeek 写 deepseek-chat；百炼兼容模式写 qwen-plus / qwen-max
# （只写半截的 qwen 会 400——模型名是厂商的版本号）
LLM_MODEL=deepseek-chat

# ── 生图与语音（可选） ───────────────────────────────────────
# 留空 = 沿用上面的 LLM_BASE_URL 与 LLM_API_KEY。
# 「文本用 DeepSeek、图与声音用百炼」是最常见的组合，所以这里可以另配一套。
#
# 填什么：**百炼，不填 OpenAI 兼容模式**。
# 因为 qwen-image 只走百炼原生接口，兼容模式没有 /images/generations。
#
# 推荐（不带 WorkspaceId，最省事，绝大多数账号可用）：
#   IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
#   TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
#
# 如果你是从控制台复制的兼容模式地址，也可以直接粘，会自动收敛到 /api/v1：
#   https://dashscope.aliyuncs.com/compatible-mode/v1
#
# 什么时候才要带 UUID：控制台给你的就是业务空间域名时（多见于国际站/多空间账号）：
#   https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
# 这种域名会原样保留——它不含 dashscope 字样，但一样按百炼协议走。
#
# 国际站：https://dashscope-intl.aliyuncs.com/api/v1
#
# 协议按地址自动识别：*.aliyuncs.com → 百炼原生；其余 → OpenAI 兼容。
# 模型名**不用填**：默认 qwen-image-2.1-turbo 与 qwen-audio-3.0-tts-flash
# （OpenAI 兼容时是 gpt-image-1 / tts-1）。要换见下方注释掉的两行。
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_API_KEY=

TTS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TTS_API_KEY=
# IMAGE_MODEL=qwen-image-3.0-pro
# TTS_MODEL=qwen-audio-3.0-tts-flash

# ── 服务 ────────────────────────────────────────────────────
# 端口。ModelScope Docker 创空间必须是 7860
PORT=3000

# 1 = 演示模式：内置样例回放，不调模型、不花钱、不需要 Key（调 UI 用）
LLM_MOCK=0

# 每日字符额度（所有请求加起来）。一局 25 幕约 14 万字符。
# 站点对外开体验时收紧到 20 万；自用可以放宽
DAILY_CHAR_BUDGET=200000

# 可选：访问口令。填了之后所有 /api 请求都要带 x-dreamloom-token 头。
# 只适合私享部署；公开分享不要填（浏览器端拿不到这个口令）
APP_ACCESS_TOKEN=

# 可选：追加允许的上游域名（逗号分隔，只允许 https）。
# 默认已放行 DeepSeek / 百炼 / OpenAI 及 *.aliyuncs.com
LLM_ALLOWED_HOSTS=
