# 复制为 .env.local（本地开发）或在部署平台的环境变量里逐条配置
# 只有这四个是密钥/环境相关，其余行为参数都在 config/app.yaml

# 必填：OpenAI 兼容接口地址（不要带 /chat/completions）
LLM_BASE_URL=https://api.deepseek.com/v1
# 必填：你的 API Key
LLM_API_KEY=
# 必填：模型名
LLM_MODEL=deepseek-chat

# 可选：服务端口（本地默认 3000；ModelScope Docker 创空间必须是 7860）
PORT=3000

# 可选：1 = 用内置假数据回放，不消耗额度、不需要 Key（本地调 UI 用）
LLM_MOCK=0
